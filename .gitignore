# Nucleul WordPress local (Docker) - vine din imaginea wordpress:6.8.1-php8.3-apache,
# nu e cod al nostru, nu are ce cauta versionat (schimba mii de fisiere la fiecare
# update de core, exact ca node_modules). Codul real e in wp-content/themes/papetarie-storefront,
# montat separat in container.
wordpress/

# Plugin-uri terte (WooCommerce, Blocksy, Loco Translate, iPay, WPForms etc.) -
# instalate din marketplace, nu cod scris de noi, se schimba la fiecare update
# de plugin exact ca nucleul WordPress de mai sus. Daca vreodata apare un
# plugin propriu, custom, se adauga explicit o exceptie (!wp-content/plugins/nume-plugin/).
wp-content/plugins/

